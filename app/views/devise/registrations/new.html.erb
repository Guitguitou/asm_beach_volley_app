<% content_for :icon do %>
  <%= render "devise/shared/icons" %>
  <%= yield :signup_icon %>
<% end %>

<% content_for :title do %>
  Créer un compte
<% end %>

<% content_for :subtitle do %>
  Rejoignez notre communauté
<% end %>

<% content_for :form do %>
  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-6" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <%= render "devise/shared/form_field", 
        f: f, 
        field_name: :email, 
        field_type: :email_field, 
        label_text: "Email",
        options: { autofocus: true, autocomplete: "email", placeholder: "votre@email.com" } %>

    <%= render "devise/shared/form_field", 
        f: f, 
        field_name: :password, 
        field_type: :password_field, 
        label_text: "Mot de passe",
        help_text: @minimum_password_length ? "(#{@minimum_password_length} caractères minimum)" : nil,
        options: { autocomplete: "new-password", placeholder: "••••••••" } %>

    <%= render "devise/shared/form_field", 
        f: f, 
        field_name: :password_confirmation, 
        field_type: :password_field, 
        label_text: "Confirmation du mot de passe",
        options: { autocomplete: "new-password", placeholder: "••••••••" } %>

    <%= render "devise/shared/submit_button", f: f, button_text: "Créer mon compte" %>
  <% end %>
<% end %>

<%= render "devise/shared/devise_layout" %>
