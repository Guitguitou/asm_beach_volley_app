<div class="space-y-3">
  <%- if controller_name != 'sessions' %>
    <%= link_to "Se connecter", new_session_path(resource_name), 
        class: "block text-center text-sm text-club-red hover:text-club-red-600 transition-colors duration-200" %>
  <% end %>

  <%- if devise_mapping.registerable? && controller_name != 'registrations' %>
    <%= link_to "Créer un compte", new_registration_path(resource_name), 
        class: "block text-center text-sm text-club-red hover:text-club-red-600 transition-colors duration-200" %>
  <% end %>

  <%- if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
    <%= link_to "Mot de passe oublié ?", new_password_path(resource_name), 
        class: "block text-center text-sm text-club-red hover:text-club-red-600 transition-colors duration-200" %>
  <% end %>

  <%- if devise_mapping.confirmable? && controller_name != 'confirmations' %>
    <%= link_to "Instructions de confirmation non reçues ?", new_confirmation_path(resource_name), 
        class: "block text-center text-sm text-club-red hover:text-club-red-600 transition-colors duration-200" %>
  <% end %>

  <%- if devise_mapping.lockable? && resource_class.unlock_strategy_enabled?(:email) && controller_name != 'unlocks' %>
    <%= link_to "Instructions de déverrouillage non reçues ?", new_unlock_path(resource_name), 
        class: "block text-center text-sm text-club-red hover:text-club-red-600 transition-colors duration-200" %>
  <% end %>

  <%- if devise_mapping.omniauthable? %>
    <%- resource_class.omniauth_providers.each do |provider| %>
      <%= button_to "Se connecter avec #{OmniAuth::Utils.camelize(provider)}", 
          omniauth_authorize_path(resource_name, provider), 
          data: { turbo: false },
          class: "w-full flex justify-center py-2 px-4 border border-gray-300 rounded-md shadow-sm bg-white text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-club-red transition-colors duration-200" %>
    <% end %>
  <% end %>
</div>
