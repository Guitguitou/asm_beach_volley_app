<% content_for :icon do %>
  <%= render "devise/shared/icons" %>
  <%= yield :key_icon %>
<% end %>

<% content_for :title do %>
  Mot de passe oublié ?
<% end %>

<% content_for :subtitle do %>
  Entrez votre email pour recevoir les instructions
<% end %>

<% content_for :form do %>
  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "space-y-6" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <%= render "devise/shared/form_field", 
        f: f, 
        field_name: :email, 
        field_type: :email_field, 
        label_text: "Email",
        options: { autofocus: true, autocomplete: "email", placeholder: "votre@email.com" } %>

    <%= render "devise/shared/submit_button", f: f, button_text: "Envoyer les instructions" %>
  <% end %>
<% end %>

<%= render "devise/shared/devise_layout" %>
